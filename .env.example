# Copie este arquivo para `.env` e ajuste o que precisar.
# Variáveis de ambiente do sistema têm prioridade sobre o que estiver aqui.

# --- Servidor ---------------------------------------------------------
# TRANSCRITOR_HOST=127.0.0.1
# TRANSCRITOR_PORT=8000
# Token exigido em todas as rotas /api. Só faça isso se for expor a máquina.
# TRANSCRITOR_TOKEN=
# Origens liberadas para CORS, separadas por vírgula.
# TRANSCRITOR_ORIGENS=
# Limite por arquivo enviado, em megabytes. 0 = sem limite.
# TRANSCRITOR_MAX_UPLOAD_MB=0

# --- Modelo e qualidade -----------------------------------------------
# TRANSCRITOR_MODELO=large-v3-turbo
# TRANSCRITOR_PERFIL=equilibrado
# Frase que ensina o modelo a escrever pt-BR pontuado e acentuado.
# TRANSCRITOR_PROMPT=

# --- Recursos extras --------------------------------------------------
# TRANSCRITOR_FALANTES=sim
# TRANSCRITOR_FALANTES_MAX=8
# Maior = menos falantes distintos identificados.
# TRANSCRITOR_FALANTES_LIMIAR=0.62
# TRANSCRITOR_ANALISE=sim
# TRANSCRITOR_RESUMO_FRASES=7
# TRANSCRITOR_CAPITULO_MIN_S=90

# --- Tratamento do áudio ----------------------------------------------
# Corta o ronco da rede elétrica e nivela o volume antes de reconhecer.
# TRANSCRITOR_TRATAR_AUDIO=sim
# TRANSCRITOR_FILTROS_AUDIO=highpass=f=60,loudnorm=I=-18:TP=-2:LRA=11

# --- Legendas ---------------------------------------------------------
# TRANSCRITOR_LEGENDA_COLUNAS=42
# TRANSCRITOR_LEGENDA_LINHAS=2
# TRANSCRITOR_LEGENDA_CPS=21

# --- Armazenamento ----------------------------------------------------
# Horas até um resultado ser apagado na inicialização. 0 = nunca apagar.
# TRANSCRITOR_RETENTION_HORAS=72
# TRANSCRITOR_APAGAR_UPLOAD=sim
# TRANSCRITOR_MANTER_AUDIO=sim
# TRANSCRITOR_OUTPUT_DIR=
# TRANSCRITOR_BANCO=
